{
  "name": "mi-iptv-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Mi IPTV / Media Center backend API (Clean Architecture)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test tests/unit/**/*.test.ts",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,js}\" \"tests/**/*.{ts,js}\" \"scripts/**/*.{ts,js}\" \"*.{js,json}\" \"openapi/**/*.json\"",
    "format:check": "prettier --check \"src/**/*.{ts,js}\" \"tests/**/*.{ts,js}\" \"scripts/**/*.{ts,js}\" \"*.{js,json}\" \"openapi/**/*.json\"",
    "openapi:verify": "tsx scripts/verify-openapi.ts",
    "security:deps": "npm audit --audit-level=high",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:seed": "tsx scripts/db-seed.ts",
    "ci": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run openapi:verify"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.2"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1"
  }
}

{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SourceCredentialsKmsDescribeOnly",
      "Effect": "Allow",
      "Action": ["kms:DescribeKey"],
      "Resource": "${SOURCE_CREDENTIALS_KMS_KEY_ARN}",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "DenySourceCredentialsDecryptFromCi",
      "Effect": "Deny",
      "Action": [
        "kms:Decrypt",
        "kms:Encrypt",
        "kms:GenerateDataKey"
      ],
      "Resource": "${SOURCE_CREDENTIALS_KMS_KEY_ARN}"
    }
  ]
}

{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SourceCredentialsKmsUseThisEnvOnly",
      "Effect": "Allow",
      "Action": [
        "kms:Encrypt",
        "kms:Decrypt",
        "kms:GenerateDataKey",
        "kms:DescribeKey"
      ],
      "Resource": "${SOURCE_CREDENTIALS_KMS_KEY_ARN}",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    }
  ]
}

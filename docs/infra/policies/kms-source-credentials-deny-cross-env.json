{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenySourceCredentialsKmsOutsideThisAccount",
      "Effect": "Deny",
      "Action": [
        "kms:Encrypt",
        "kms:Decrypt",
        "kms:GenerateDataKey"
      ],
      "NotResource": "${SOURCE_CREDENTIALS_KMS_KEY_ARN}"
    },
    {
      "Sid": "DenyCredentialKeyDeletion",
      "Effect": "Deny",
      "Action": [
        "kms:ScheduleKeyDeletion",
        "kms:DeleteAlias"
      ],
      "Resource": "*"
    }
  ]
}

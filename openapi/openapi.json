{
  "openapi": "3.1.0",
  "info": {
    "title": "Mi IPTV Backend API",
    "version": "0.1.0",
    "description": "MVP backend contract. Public API grows under /api/v1; /health is the ALB probe."
  },
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Liveness / readiness probe",
        "responses": {
          "200": {
            "description": "Service is up",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["status"],
                  "properties": {
                    "status": { "type": "string", "example": "ok" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "operationId": "login",
        "summary": "Authenticate with email and password",
        "description": "Binds the session to deviceId. Wrong email and wrong password return the same AUTH_INVALID error. After 5 failed attempts per IP or account in 15 minutes, returns 429 with Retry-After (BE-028).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authenticated session",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LoginResponse" }
              }
            }
          },
          "400": {
            "description": "Missing or invalid input",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthError" }
              }
            }
          },
          "401": {
            "description": "Invalid email or password (uniform)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthError" }
              }
            }
          },
          "403": {
            "description": "Account inactive",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthError" }
              }
            }
          },
          "429": {
            "description": "Brute-force lockout (per IP or account)",
            "headers": {
              "Retry-After": {
                "description": "Seconds until the lockout window expires",
                "schema": { "type": "integer", "minimum": 1 }
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthRateLimitError" }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "operationId": "refresh",
        "summary": "Rotate refresh token and issue a new access JWT",
        "description": "Marks the presented refresh token as used, returns a new access + refresh pair in the same family. Reuse of a spent token revokes the family.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RefreshRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Rotated session tokens",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RefreshResponse" }
              }
            }
          },
          "400": {
            "description": "Missing or invalid input",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthError" }
              }
            }
          },
          "401": {
            "description": "Invalid, revoked, expired, or reused refresh token",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthError" }
              }
            }
          },
          "403": {
            "description": "Account inactive",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthError" }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "logout",
        "summary": "Revoke the current device session (or all sessions)",
        "description": "Places the access JWT jti on the Redis deny-list and revokes refresh tokens for the device. Set allSessions=true to close every account session (Security §2.2 / BE-025).",
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "required": false,
            "schema": { "type": "string" },
            "description": "Bearer access JWT (preferred)"
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LogoutRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Session(s) revoked",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LogoutResponse" }
              }
            }
          },
          "400": {
            "description": "Missing or invalid input",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthError" }
              }
            }
          },
          "401": {
            "description": "Missing or invalid access token",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthError" }
              }
            }
          }
        }
      }
    },
    "/api/v1/sources": {
      "get": {
        "operationId": "listSources",
        "summary": "List account IPTV sources",
        "parameters": [
          {
            "name": "x-account-id",
            "in": "header",
            "required": true,
            "schema": { "type": "string", "format": "uuid" },
            "description": "Sprint 0 stand-in for JWT account scope"
          }
        ],
        "responses": {
          "200": {
            "description": "Source list (credentials masked)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["items"],
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/SourcePublic" }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createSource",
        "summary": "Add an M3U or Xtream source",
        "parameters": [
          {
            "name": "x-account-id",
            "in": "header",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateSourceRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created (credentials masked)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SourcePublic" }
              }
            }
          }
        }
      }
    },
    "/api/v1/sources/{id}": {
      "patch": {
        "operationId": "updateSource",
        "summary": "Edit, prioritize, or deactivate a source",
        "parameters": [
          {
            "name": "x-account-id",
            "in": "header",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateSourceRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated (credentials masked)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SourcePublic" }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteSource",
        "summary": "Delete (tombstone) a source",
        "parameters": [
          {
            "name": "x-account-id",
            "in": "header",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "204": { "description": "Deleted" }
        }
      }
    },
    "/api/v1/sources/{id}/test": {
      "post": {
        "operationId": "testSource",
        "summary": "Connectivity-check an IPTV source",
        "description": "Probes M3U playlist fetch/parse or Xtream player_api auth. Returns a classified reason without clearing user input.",
        "parameters": [
          {
            "name": "x-account-id",
            "in": "header",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "Connectivity check succeeded",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SourceTestResult" }
              }
            }
          },
          "422": {
            "description": "Connectivity check failed with classified reason",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SourceTestResult" }
              }
            }
          }
        }
      }
    },
    "/api/v1/devices": {
      "get": {
        "operationId": "listDevices",
        "summary": "List linked devices for the account",
        "parameters": [
          {
            "name": "x-account-id",
            "in": "header",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "Active devices (push tokens never returned)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["items"],
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/DevicePublic" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/devices/register": {
      "post": {
        "operationId": "registerDevice",
        "summary": "Register a TV or Companion device",
        "parameters": [
          {
            "name": "x-account-id",
            "in": "header",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RegisterDeviceRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Registered",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DevicePublic" }
              }
            }
          }
        }
      }
    },
    "/api/v1/devices/{id}": {
      "delete": {
        "operationId": "unlinkDevice",
        "summary": "Unlink (revoke) a device",
        "parameters": [
          {
            "name": "x-account-id",
            "in": "header",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "204": { "description": "Unlinked" }
        }
      }
    },
    "/api/v1/devices/{id}/heartbeat": {
      "post": {
        "operationId": "deviceHeartbeat",
        "summary": "Update device last_seen_at (optional push token refresh)",
        "parameters": [
          {
            "name": "x-account-id",
            "in": "header",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "pushToken": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Heartbeat accepted",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DevicePublic" }
              }
            }
          }
        }
      }
    },
    "/api/v1/sync/playback-state": {
      "post": {
        "operationId": "upsertPlaybackState",
        "summary": "Upsert playback progress (offline-first sync)",
        "description": "Idempotent via clientEventId. Applies syncVersion optimistic concurrency, server-clock LWW, and a 60s max-position window unless forceReset is true (ADR-005 / BE-061).",
        "parameters": [
          {
            "name": "x-account-id",
            "in": "header",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "name": "x-profile-id",
            "in": "header",
            "required": true,
            "schema": { "type": "string", "format": "uuid" },
            "description": "Sprint 0 stand-in for active profile context"
          },
          {
            "name": "x-device-id",
            "in": "header",
            "required": true,
            "schema": { "type": "string", "format": "uuid" },
            "description": "Sprint 0 stand-in for JWT deviceId claim"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpsertPlaybackStateRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Decision applied or idempotent replay (accepted may be false)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UpsertPlaybackStateResponse" }
              }
            }
          },
          "400": {
            "description": "Invalid payload or domain validation failure",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthError" }
              }
            }
          },
          "401": {
            "description": "Missing account/profile/device context headers"
          }
        }
      }
    },
    "/api/v1/sync/favorites": {
      "get": {
        "operationId": "listFavorites",
        "summary": "List favorites for the active profile",
        "description": "Returns non-deleted favorites scoped to x-profile-id, ordered by sortOrder then createdAt (BE-063).",
        "parameters": [
          {
            "name": "x-account-id",
            "in": "header",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "name": "x-profile-id",
            "in": "header",
            "required": true,
            "schema": { "type": "string", "format": "uuid" },
            "description": "Sprint 0 stand-in for active profile context"
          }
        ],
        "responses": {
          "200": {
            "description": "Active favorites for the profile",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["items"],
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/FavoritePublic" }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing account/profile context headers"
          }
        }
      },
      "post": {
        "operationId": "setFavorite",
        "summary": "Add or remove a favorite (offline-first sync)",
        "description": "Idempotent via clientEventId. Always accepts; marks resolvedBy=lww on concurrent syncVersion mismatch. Optional sortOrder and type (ADR-005 / BE-063).",
        "parameters": [
          {
            "name": "x-account-id",
            "in": "header",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "name": "x-profile-id",
            "in": "header",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "name": "x-device-id",
            "in": "header",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SetFavoriteRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Write applied or idempotent replay",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SetFavoriteResponse" }
              }
            }
          },
          "400": {
            "description": "Invalid payload or domain validation failure",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthError" }
              }
            }
          },
          "401": {
            "description": "Missing account/profile/device context headers"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SourcePublic": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "name",
          "uriRef",
          "priority",
          "enabled",
          "status",
          "statusReason",
          "syncVersion",
          "credentialsConfigured",
          "username",
          "password",
          "token"
        ],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "kind": {
            "type": "string",
            "enum": ["m3u", "xtream", "proprietary"]
          },
          "name": { "type": "string" },
          "uriRef": { "type": ["string", "null"] },
          "priority": { "type": "integer" },
          "enabled": { "type": "boolean" },
          "status": { "type": "string" },
          "statusReason": {
            "type": ["string", "null"],
            "description": "Last connectivity classification from POST /test"
          },
          "syncVersion": { "type": "integer" },
          "credentialsConfigured": { "type": "boolean" },
          "username": { "type": "null" },
          "password": { "type": "null" },
          "token": { "type": "null" }
        }
      },
      "SourceTestResult": {
        "type": "object",
        "required": ["ok", "reason", "message", "source"],
        "properties": {
          "ok": { "type": "boolean" },
          "reason": {
            "type": "string",
            "enum": [
              "ok",
              "unreachable",
              "auth_failed",
              "invalid_playlist",
              "timeout"
            ]
          },
          "message": { "type": "string" },
          "source": { "$ref": "#/components/schemas/SourcePublic" }
        }
      },
      "CreateSourceRequest": {
        "type": "object",
        "required": ["kind", "name", "uriRef"],
        "properties": {
          "kind": { "type": "string", "enum": ["m3u", "xtream"] },
          "name": { "type": "string" },
          "uriRef": { "type": "string" },
          "priority": { "type": "integer" },
          "credentials": {
            "type": "object",
            "properties": {
              "username": { "type": "string" },
              "password": { "type": "string" },
              "token": { "type": "string" }
            }
          }
        }
      },
      "UpdateSourceRequest": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "uriRef": { "type": "string" },
          "priority": { "type": "integer" },
          "enabled": {
            "type": "boolean",
            "description": "false deactivates without deleting"
          },
          "credentials": {
            "type": "object",
            "properties": {
              "username": { "type": "string" },
              "password": { "type": "string" },
              "token": { "type": "string" }
            }
          }
        }
      },
      "DevicePublic": {
        "type": "object",
        "required": [
          "id",
          "deviceType",
          "platform",
          "name",
          "model",
          "appVersion",
          "osVersion",
          "pushTokenConfigured",
          "pairedAt",
          "lastSeenAt"
        ],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "deviceType": { "type": "string", "enum": ["tv", "companion"] },
          "platform": {
            "type": "string",
            "enum": ["android_tv", "android", "ios"]
          },
          "name": { "type": ["string", "null"] },
          "model": { "type": ["string", "null"] },
          "appVersion": { "type": ["string", "null"] },
          "osVersion": { "type": ["string", "null"] },
          "pushTokenConfigured": { "type": "boolean" },
          "pairedAt": { "type": "string", "format": "date-time" },
          "lastSeenAt": { "type": ["string", "null"], "format": "date-time" }
        }
      },
      "RegisterDeviceRequest": {
        "type": "object",
        "required": ["deviceType", "platform"],
        "properties": {
          "deviceType": { "type": "string", "enum": ["tv", "companion"] },
          "platform": {
            "type": "string",
            "enum": ["android_tv", "android", "ios"]
          },
          "name": { "type": "string" },
          "model": { "type": "string" },
          "appVersion": { "type": "string" },
          "osVersion": { "type": "string" },
          "pushToken": { "type": "string" }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["email", "password", "deviceId"],
        "properties": {
          "email": { "type": "string", "format": "email" },
          "password": { "type": "string", "format": "password" },
          "deviceId": {
            "type": "string",
            "format": "uuid",
            "description": "Device that owns the refresh session (BE-023)"
          }
        }
      },
      "LoginResponse": {
        "type": "object",
        "required": ["accountId", "accessToken", "refreshToken", "expiresIn"],
        "properties": {
          "accountId": { "type": "string", "format": "uuid" },
          "accessToken": { "type": "string" },
          "refreshToken": { "type": "string" },
          "expiresIn": {
            "type": "integer",
            "description": "Access token TTL in seconds",
            "example": 3600
          }
        }
      },
      "RefreshRequest": {
        "type": "object",
        "required": ["refreshToken"],
        "properties": {
          "refreshToken": {
            "type": "string",
            "description": "Opaque refresh token from login or prior rotation"
          }
        }
      },
      "RefreshResponse": {
        "type": "object",
        "required": ["accountId", "accessToken", "refreshToken", "expiresIn"],
        "properties": {
          "accountId": { "type": "string", "format": "uuid" },
          "accessToken": { "type": "string" },
          "refreshToken": {
            "type": "string",
            "description": "Rotated refresh token; previous token is spent"
          },
          "expiresIn": {
            "type": "integer",
            "description": "Access token TTL in seconds",
            "example": 3600
          }
        }
      },
      "AuthError": {
        "type": "object",
        "required": ["error", "code"],
        "properties": {
          "error": { "type": "string" },
          "code": { "type": "string" }
        }
      },
      "AuthRateLimitError": {
        "type": "object",
        "required": ["error", "code", "retryAfter"],
        "properties": {
          "error": { "type": "string" },
          "code": { "type": "string", "enum": ["AUTH_RATE_LIMITED"] },
          "retryAfter": {
            "type": "integer",
            "minimum": 1,
            "description": "Seconds until retry is allowed"
          }
        }
      },
      "LogoutRequest": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "Access JWT when Authorization header is unavailable"
          },
          "allSessions": {
            "type": "boolean",
            "default": false,
            "description": "When true, revoke every device session for the account"
          },
          "allDevices": {
            "type": "boolean",
            "default": false,
            "description": "Alias of allSessions"
          }
        }
      },
      "LogoutResponse": {
        "type": "object",
        "required": ["status", "scope"],
        "properties": {

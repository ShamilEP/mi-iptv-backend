{
  "openapi": "3.1.0",
  "info": {
    "title": "Mi IPTV Backend API",
    "version": "0.1.0",
    "description": "MVP backend contract. Public API grows under /api/v1; /health is the ALB probe."
  },
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Liveness / readiness probe",
        "responses": {
          "200": {
            "description": "Service is up",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["status"],
                  "properties": {
                    "status": { "type": "string", "example": "ok" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

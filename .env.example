# Placeholder names only — set real values locally. Never commit real secrets.
# APP_ENV selects DEV/QA/PROD secret + KMS scope (see docs/infra/013-config-secrets-kms.md).
APP_ENV=dev
NODE_ENV=development
PORT=3000
# LOG_LEVEL=debug
DATABASE_URL=postgresql://user:password@localhost:5432/mi_iptv
REDIS_URL=redis://localhost:6379
JWT_ACCESS_TTL_SECONDS=3600
JWT_REFRESH_TTL_SECONDS=2592000
# Optional override of the env-scoped mock/real KMS key id (never paste key material).
# KMS_KEY_ID=arn:aws:kms:us-east-1:000000000001:key/mock-dev
# Source-credential encryption CMK (INF-023); distinct from general secrets KMS when live.
# SOURCE_CREDENTIALS_KMS_KEY_ID=arn:aws:kms:us-east-1:000000000001:key/mock-dev-source-creds
# JWT_PRIVATE_KEY=
# JWT_PUBLIC_KEY=
# SOURCE_CREDENTIALS_DATA_KEY=
